# Bu dosyayi .env.development / .env.test / .env.production olarak kopyalayip doldur.
# Tum degiskenler apps/server/src/config/env.validation.ts icinde Joi ile dogrulanir;
# eksik veya hatali bir deger varsa uygulama acilista TEK SEFERDE hepsini raporlar.

# ------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api   # Client'in cagirdigi API tabani

# ------------------------------------------------------------------
# Sunucu
# ------------------------------------------------------------------
SERVER_PORT=3000                                # Nest'in dinledigi port
NODE_ENV=development                            # development | test | production
LOG_LEVEL=debug                                 # error | warn | info | debug | verbose
FRONTEND_URL=http://localhost:3001              # E-posta dogrulama linkinin tabani
CORS_ORIGINS=http://localhost:3001              # Virgulle ayrik whitelist. "*" desteklenmez

# ------------------------------------------------------------------
# Veritabani (PostgreSQL)
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/codxus_dev?schema=public

# ------------------------------------------------------------------
# Redis  -> infra/docker-compose.yml
# Cache, rate limit sayaclari ve mail kuyrugu ayni instance'i kullanir.
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------
# Mail  -> lokalde Mailpit (infra/docker-compose.yml), arayuz :8026
# ------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1026                                  # Mailpit SMTP portu (infra/docker-compose.yml)
MAIL_SECURE=false                               # true ise TLS (prod'da 465 icin)
MAIL_USER=                                      # Mailpit'te bos birakilir
MAIL_PASSWORD=                                  # Mailpit'te bos birakilir
MAIL_FROM_ADDRESS=noreply@codxus.com            # Gonderen adres
MAIL_FROM_NAME=Codxus                           # Gonderen gorunen adi

# ------------------------------------------------------------------
# Guvenlik
# ------------------------------------------------------------------
ARGON2_MEMORY_COST=19456                        # KiB (19 MiB) - OWASP asgarisi
ARGON2_TIME_COST=2                              # Iterasyon sayisi
ARGON2_PARALLELISM=1                            # Paralel thread
EMAIL_VERIFICATION_TTL_HOURS=24                 # Dogrulama tokeninin omru
EMAIL_RESEND_COOLDOWN_SECONDS=60                # Iki dogrulama maili arasi asgari sure
HIBP_TIMEOUT_MS=3000                            # HaveIBeenPwned timeout; asilirsa fail-open
TERMS_VERSION=v1                                # Kullanicinin kabul ettigi sozlesme surumu
PRIVACY_VERSION=v1                              # Gizlilik/aydinlatma metni surumu

# ------------------------------------------------------------------
# Sonraki gorev (login / session) icin ayrilmis
# ------------------------------------------------------------------
REFRESH_TOKEN_EXPIRES_DAYS=30                   # Refresh token omru (gun)
COOKIE_DOMAIN=                                  # Bos birakilabilir
